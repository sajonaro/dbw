{
  "name": "dbw-workspace",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "description": "dbw: a database workbench for VS Code, one plugin per dialect and driver.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/extension",
    "watch": "npm run watch -w packages/extension",
    "package": "npm run package -w packages/extension",
    "typecheck": "tsc -p packages/extension --noEmit && tsc -p packages/core --noEmit",
    "test": "vitest run",
    "version": "node scripts/version.mjs",
    "vsix": "docker build --target dist --output out .",
    "check": "node scripts/check.cjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "@vscode/vsce-sign@2.1.0": true
  }
}
